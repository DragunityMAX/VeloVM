+                            ..Default::default()
+                        }),
+                        ..Default::default()
+                    }),
+                })
+                .await
+                .unwrap_err();
+            assert!(
+                !err.to_string().contains("already exists"),
+                "unexpected error: {err:#}"
+            );
+            assert!(!fresh_shm.exists());
+            assert!(svc.fastdesk_shm_path.is_none());
+        });
