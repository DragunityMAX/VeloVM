+                    log_id: "test".into(),
+                    config: Some(vmservice::VmConfig {
+                        fastdesk_config: Some(vmservice::FastDeskConfig {
+                            listen_addr: "127.0.0.1:0".into(),
+                            shm_path: Some(fresh_shm.to_string_lossy().into_owned()),
