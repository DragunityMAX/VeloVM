+                };
+                rpc.complete(true);
+            };
+            futures::join!(handle_resume, resume_responder);
+            resume_res.await.unwrap().unwrap();
+            assert_eq!(
+                service.build_properties().state,
+                vmservice::VmState::Running as i32
+            );
+        });
+    }
