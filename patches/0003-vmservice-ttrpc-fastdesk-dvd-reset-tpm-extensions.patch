 async fn make_disk_config(disk: vmservice::ScsiDisk) -> anyhow::Result<ScsiDeviceAndPath> {
+    let read_only = disk.read_only || disk.is_dvd;
+    let options = OpenDiskOptions {
+        read_only,
+        direct: false,
+    };
