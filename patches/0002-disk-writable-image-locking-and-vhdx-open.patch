+#[cfg(unix)]
+fn is_unsupported_lock_error(err: &std::io::Error) -> bool {
+    err.kind() == std::io::ErrorKind::Unsupported
+        || matches!(
+            err.raw_os_error(),
+            Some(libc::ENOLCK | libc::EOPNOTSUPP | libc::ENOSYS)
+        )
+}
+
+#[cfg(unix)]
+fn handle_disk_lock_result(
+    res: Result<(), std::fs::TryLockError>,
+    path: &Path,
+    read_only: bool,
+) -> anyhow::Result<()> {
+    match res {
+        Ok(()) => Ok(()),
+        Err(std::fs::TryLockError::WouldBlock) => {
+            anyhow::bail!(
+                "disk image '{}' is already locked for writing or in use by another process",
+                path.display()
+            );
+        }
+        Err(std::fs::TryLockError::Error(err)) if is_unsupported_lock_error(&err) => {
+            // Match QEMU's fallback on filesystems without advisory lock support
+            // (e.g., ENOLCK / EOPNOTSUPP / ENOSYS on NFS, CIFS, or 9p): warn and continue.
+            tracing::warn!(
+                path = %path.display(),
+                read_only,
+                error = %err,
+                "disk locking unavailable on this filesystem; continuing without file lock"
+            );
+            Ok(())
+        }
+        Err(std::fs::TryLockError::Error(err)) => {
+            Err(err).with_context(|| format!("acquiring file lock on {}", path.display()))
+        }
+    }
+}
+
+#[cfg(unix)]
+fn acquire_disk_lock(file: &std::fs::File, path: &Path, read_only: bool) -> anyhow::Result<()> {
+    if file.metadata().is_ok_and(|m| m.is_file()) {
+        let res = if read_only {
+            file.try_lock_shared()
+        } else {
+            file.try_lock()
+        };
+        handle_disk_lock_result(res, path, read_only)?;
+    }
+    Ok(())
+}
+
+fn open_disk_file_with_lock(
+    path: &Path,
+    read_only: bool,
+    create: bool,
+    direct: bool,
+    verb: &str,
+) -> anyhow::Result<std::fs::File> {
+    let writable = !read_only || create;
+    let mut opts = std::fs::OpenOptions::new();
+    opts.read(true).write(writable);
+    if create {
+        opts.create(true).truncate(false);
+    }
+
+    #[cfg(target_os = "linux")]
+    if direct {
+        use std::os::unix::fs::OpenOptionsExt;
+        opts.custom_flags(libc::O_DIRECT);
+    }
+    #[cfg(not(target_os = "linux"))]
+    let _ = direct;
+
+    #[cfg(windows)]
+    if writable && (create || path.is_file()) {
+        use std::os::windows::fs::OpenOptionsExt;
+        // Deny concurrent writers (`FILE_SHARE_READ` without `FILE_SHARE_WRITE`)
+        // on writable opens and disk creation.
+        opts.share_mode(0x0000_0001);
+    }
+
+    let file = match opts.open(path) {
+        Ok(file) => file,
+        #[cfg(windows)]
+        Err(err) if writable && err.raw_os_error() == Some(32) => {
+            anyhow::bail!(
+                "disk image '{}' is already locked for writing or in use by another process",
+                path.display()
+            );
+        }
+        Err(err) => return Err(err).with_context(|| disk_open_error(path, verb)),
+    };
+
+    #[cfg(unix)]
+    acquire_disk_lock(&file, path, !writable)?;
+
+    Ok(file)
+}
